# =============================================================================
# Swayam — environment configuration
#
# Copy to .env with `make setup` (or `scripts/setup.sh`). The setup script
# replaces every __GENERATE__ value with a fresh random secret. Never commit
# the generated .env file.
# =============================================================================

# ----------------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Swayam by TechSara"
LOG_LEVEL=INFO
LOG_JSON=true
# Public origin that browsers use (edge proxy). Used for invite links and CORS.
PUBLIC_BASE_URL=http://localhost:3200
# Public access through a Cloudflare Tunnel (compose profile "tunnel"): set PUBLIC_BASE_URL to the
# tunnel's public hostname (e.g. https://swayam.example.com), add "tunnel" to COMPOSE_PROFILES and
# paste the connector token from the Cloudflare dashboard here. The hostname's service is
# http://127.0.0.1:3280 (the edge's tunnel listener).
CLOUDFLARE_TUNNEL_TOKEN=
API_HOST=127.0.0.1
API_PORT=8200
WORKER_METRICS_PORT=8201
ENABLE_API_DOCS=true
# Test-only control endpoints (fast-forward time etc.). Never enable in production.
ENABLE_TEST_HOOKS=false
# Shared secret every /api/v1/test/* call must send as X-Test-Hooks-Token.
TEST_HOOKS_TOKEN=__GENERATE__
# Extra origins allowed by CORS (comma separated). The edge proxy serves the SPA
# and API from one origin, so this is only needed for the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ----------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------
JWT_SECRET=__GENERATE__
JWT_PREVIOUS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
CANDIDATE_SESSION_TTL_SECONDS=21600
# Started interviews nobody drives any more (no runtime, no heartbeat) are ended after this many
# seconds (scoring + partial report run; recruiters see them in review). Must exceed
# WS_DISCONNECT_GRACE_SECONDS (180) by at least 60. SESSION_SWEEP_DRY_RUN=true only reports.
SESSION_ABANDON_AFTER_SECONDS=1200
SESSION_SWEEP_DRY_RUN=false
# Browsers treat http://localhost as a secure context, so Secure cookies work
# locally in Chrome/Firefox. Set to false only for plain-HTTP LAN testing.
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Prefix for every cookie name. Browsers share cookies across ports, so a second copy on the same host needs
# its own (the dev copy on :3201 uses dev_; scripts/deploy.sh sets it). Empty for production.
COOKIE_NAME_PREFIX=
CSRF_ENABLED=true
INVITE_TTL_HOURS=168
# Signs short-lived media URLs served by the API (storage proxy mode).
MEDIA_URL_SECRET=__GENERATE__

# ----------------------------------------------------------------------------
# PostgreSQL (pgvector)
# ----------------------------------------------------------------------------
POSTGRES_USER=interview
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=interview
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442
DATABASE_URL=postgresql+asyncpg://interview:${POSTGRES_PASSWORD}@127.0.0.1:5442/interview

# ----------------------------------------------------------------------------
# Redis
# ----------------------------------------------------------------------------
REDIS_PASSWORD=__GENERATE__
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6390/0

# ----------------------------------------------------------------------------
# File storage — local filesystem (no S3/MinIO). Resumes, answer audio, frames
# and report artifacts live under STORAGE_LOCAL_ROOT and are served only by the
# API behind authorization checks and short-lived HMAC-signed URLs.
# ----------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
# Recording upload budget per session and kind: (max duration + 15 min) x bitrate; parts cap; pre-start budget.
# Uploads stop (503 storage_full) below STORAGE_MIN_FREE_RATIO free disk.
RECORDING_MAX_BITRATE_BPS=2000000
RECORDING_MAX_PARTS_PER_SESSION=40
RECORDING_PRESTART_BUDGET_BYTES=50331648
STORAGE_MIN_FREE_RATIO=0.10
MEDIA_URL_TTL_SECONDS=300

# ----------------------------------------------------------------------------
# Local AI inference endpoints (already running; never duplicated here)
# ----------------------------------------------------------------------------
MAIN_LLM_BASE_URL=http://localhost:8000/v1
MAIN_LLM_MODEL=Qwen/Qwen3.6-35B-A3B-NVFP4

VISION_LLM_BASE_URL=http://localhost:8002/v1
VISION_LLM_MODEL=Qwen/Qwen3-VL-8B-Instruct-FP8

EMBEDDING_BASE_URL=http://localhost:8003/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIMENSIONS=1024

RERANKER_BASE_URL=http://localhost:8005
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

WHISPER_BASE_URL=http://172.17.0.1:30007/v1
WHISPER_MODEL=openai/whisper-large-v3
# Optional extra Whisper replicas (comma separated) used for load spreading. Each replica
# transcribes one request at a time, so a second replica (e.g. the worker node's
# http://192.168.9.68:30007/v1) roughly halves end-of-turn transcription waits.
WHISPER_EXTRA_BASE_URLS=
WHISPER_LANGUAGE=en
# Optional fast interview STT on this node's GPU: Whisper large-v3-turbo on vLLM (compose profile "stt",
# services/stt; ~5x faster than the shared large-v3 server, batches requests). To use it:
#   COMPOSE_PROFILES=stt
#   WHISPER_BASE_URL=http://127.0.0.1:30017/v1
#   WHISPER_MODEL=openai/whisper-large-v3-turbo
#   WHISPER_BASE_URL_PARALLELISM=4
#   WHISPER_EXTRA_BASE_URLS=<the shared Whisper URL>   (fallback replica)
# Requests WHISPER_BASE_URL serves at once (1 for the shared one-at-a-time server).
WHISPER_BASE_URL_PARALLELISM=1
# Interim (partial) transcript interval; raise it when Whisper is shared and busy.
STT_PARTIAL_INTERVAL_MS=2000

OCR_BASE_URL=http://192.168.9.68:30004/v1

# Endpoints this node does not have (comma separated: vision, embedding, reranker, ocr). Calls fail
# fast and dependent features degrade cleanly (no camera-frame AI analysis / question-bank semantic
# search / scanned-resume OCR); main, whisper and tts can never be disabled.
AI_DISABLED_ENDPOINTS=
OCR_MODEL=baidu/Unlimited-OCR
OCR_PROMPT=OCR

# Optional per-task routing overrides, JSON object of task -> main|vision.
# Example: {"answer_assessment":"vision"}
MODEL_ROUTING_OVERRIDES={}
MODEL_CALL_LOG_PAYLOADS=false

# ----------------------------------------------------------------------------
# Text-to-speech (pluggable: kokoro | openai_compatible | browser | mock)
# ----------------------------------------------------------------------------
TTS_PROVIDER=kokoro
TTS_BASE_URL=http://127.0.0.1:8210
TTS_MODEL=kokoro-v1.0
TTS_VOICE=af_heart
TTS_SAMPLE_RATE=24000
TTS_PORT=8210
TTS_THREADS=4

# ----------------------------------------------------------------------------
# Code execution sandbox
# ----------------------------------------------------------------------------
SANDBOX_BASE_URL=http://127.0.0.1:8220
SANDBOX_SHARED_SECRET=__GENERATE__
SANDBOX_PORT=8220
SANDBOX_MAX_CONCURRENCY=4

# ----------------------------------------------------------------------------
# Malware scanning for uploads: off | optional | required
# ----------------------------------------------------------------------------
MALWARE_SCAN_MODE=optional
CLAMAV_HOST=
CLAMAV_PORT=3310

# ----------------------------------------------------------------------------
# Observability
# ----------------------------------------------------------------------------
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=__GENERATE__

# ----------------------------------------------------------------------------
# Development seed users (passwords generated by setup; printed by `make seed`)
# ----------------------------------------------------------------------------
SEED_SUPERADMIN_EMAIL=superadmin@demo.local
SEED_ADMIN_EMAIL=admin@demo.local
SEED_RECRUITER_EMAIL=recruiter@demo.local
SEED_INTERVIEWER_EMAIL=interviewer@demo.local
SEED_PASSWORD=__GENERATE__
