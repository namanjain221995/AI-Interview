<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="{{ CSP }}">
<meta name="referrer" content="no-referrer">
<title>{% block title %}Interview report{% endblock %}</title>
<style>
  :root {
    --ink: #17202c; --ink-2: #3d4a5c; --muted: #6b778a; --line: #e2e6ec; --soft: #f5f7fa;
    --accent: #3451c6; --accent-soft: #eef1fc;
    --high: #1f8a5b; --mid: #2c7da0; --low: #b7791f; --weak: #b44a4a;
    --radius: 10px;
  }
  * { box-sizing: border-box; }
  html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  body { margin: 0; background: #fff; color: var(--ink); font: 14px/1.55 -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; }
  .page { max-width: 960px; margin: 0 auto; padding: 32px 36px 48px; }
  h1 { font-size: 26px; line-height: 1.2; margin: 0 0 4px; letter-spacing: -0.01em; }
  h2 { font-size: 17px; margin: 32px 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--ink); letter-spacing: 0.01em; }
  h3 { font-size: 14.5px; margin: 0 0 6px; }
  p { margin: 0 0 8px; }
  .muted { color: var(--muted); }
  .small { font-size: 12px; }
  .eyebrow { text-transform: uppercase; letter-spacing: 0.12em; font-size: 11px; color: var(--accent); font-weight: 700; margin-bottom: 6px; }
  header.report { display: flex; justify-content: space-between; gap: 24px; align-items: flex-start; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .meta-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px 20px; margin: 18px 0 4px; }
  .meta-grid div span { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .meta-grid div strong { font-weight: 600; }
  .score-hero { text-align: right; min-width: 150px; }
  .score-hero .value { font-size: 44px; font-weight: 750; line-height: 1; letter-spacing: -0.02em; }
  .score-hero .value small { font-size: 16px; color: var(--muted); font-weight: 500; }
  .score-hero .conf { font-size: 12px; color: var(--muted); margin-top: 4px; }
  .banner { border: 1px solid var(--line); border-left: 4px solid var(--accent); background: var(--accent-soft); border-radius: var(--radius); padding: 14px 16px; margin: 20px 0 6px; }
  .banner .rec { font-size: 16px; font-weight: 700; }
  .banner.note { border-left-color: var(--muted); background: var(--soft); }
  .card { border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; margin: 0 0 12px; background: #fff; break-inside: avoid; page-break-inside: avoid; }
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .bar { position: relative; height: 8px; background: var(--soft); border-radius: 99px; overflow: hidden; border: 1px solid var(--line); }
  .bar > i { position: absolute; inset: 0 auto 0 0; border-radius: 99px; }
  .band-high > i, i.band-high { background: var(--high); }
  .band-mid > i, i.band-mid { background: var(--mid); }
  .band-low > i, i.band-low { background: var(--low); }
  .band-weak > i, i.band-weak { background: var(--weak); }
  .band-none > i, i.band-none { background: var(--muted); }
  table { width: 100%; border-collapse: collapse; margin: 4px 0 8px; }
  th, td { text-align: left; vertical-align: top; padding: 7px 8px; border-bottom: 1px solid var(--line); }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--muted); font-weight: 600; }
  td.num, th.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pill { display: inline-block; padding: 1px 8px; border-radius: 99px; font-size: 11.5px; font-weight: 600; border: 1px solid var(--line); background: var(--soft); color: var(--ink-2); white-space: nowrap; }
  .pill.pos { color: var(--high); border-color: #bfe3d1; background: #effaf4; }
  .pill.neg { color: var(--weak); border-color: #efcaca; background: #fdf3f3; }
  .pill.warn { color: var(--low); border-color: #f0dcb5; background: #fdf7ec; }
  .pill.accent { color: var(--accent); border-color: #c9d2f5; background: var(--accent-soft); }
  ul.clean { margin: 4px 0 0; padding-left: 18px; }
  ul.clean li { margin: 2px 0; }
  .evidence { border-left: 3px solid var(--line); padding: 4px 0 4px 10px; margin: 6px 0; }
  .evidence.positive { border-left-color: var(--high); }
  .evidence.negative { border-left-color: var(--weak); }
  .evidence q { color: var(--ink-2); font-style: italic; }
  .qa .question { font-weight: 600; }
  .qa .answer { margin: 6px 0; padding: 8px 10px; background: var(--soft); border-radius: 8px; color: var(--ink-2); white-space: pre-wrap; }
  .dims { display: flex; flex-wrap: wrap; gap: 4px 6px; margin: 6px 0; }
  pre.code { font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; background: #0f1724; color: #e6edf6; padding: 12px 14px; border-radius: 8px; white-space: pre-wrap; word-break: break-word; }
  footer.report { margin-top: 36px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 11.5px; color: var(--muted); display: flex; justify-content: space-between; gap: 16px; }
  .ids { font: 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--muted); }
  @media (max-width: 720px) { .meta-grid { grid-template-columns: repeat(2, 1fr); } .grid-2 { grid-template-columns: 1fr; } header.report { flex-direction: column; } .score-hero { text-align: left; } }
  @page { size: A4; margin: 14mm 13mm 16mm; }
  @media print {
    body { font-size: 11.5px; }
    .page { padding: 0; max-width: none; }
    h2 { break-after: avoid; page-break-after: avoid; margin-top: 22px; }
    .card, tr, .evidence { break-inside: avoid; page-break-inside: avoid; }
    .page-break { break-before: page; page-break-before: always; }
    a { color: inherit; text-decoration: none; }
  }
</style>
</head>
<body>
<main class="page">
{% block body %}{% endblock %}
<footer class="report">
  <div>{% block footer_note %}Generated by Swayam by TechSara.{% endblock %}</div>
  <div class="ids">Report v{{ meta.version }} · {{ meta.report_id }} · {{ meta.generated_at | date }}</div>
</footer>
</main>
</body>
</html>
