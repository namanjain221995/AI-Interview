{% extends "base.html.j2" %}
{% set n = c.narrative %}
{% block title %}Interview feedback — {{ c.job.title or "Interview" }}{% endblock %}
{% block body %}
<header class="report">
  <div>
    <div class="eyebrow">Interview feedback</div>
    <h1>{{ c.candidate.full_name or "Your interview" }}</h1>
    <div class="muted">{{ c.job.title or "Role" }} · {{ c.round.name }}</div>
    <div class="meta-grid">
      <div><span>Date</span><strong>{{ c.session.started_at | date }}</strong></div>
      <div><span>Interview time</span><strong>{{ c.session.elapsed_seconds | duration }}</strong></div>
      <div><span>Questions</span><strong>{{ c.questions | length }}</strong></div>
      <div><span>Areas assessed</span><strong>{{ c.competencies | length }}</strong></div>
    </div>
  </div>
  <div class="score-hero">
    <div class="small muted">Overall score</div>
    <div class="value">{{ c.overall_score | num(0) }}<small>/100</small></div>
  </div>
</header>

<h2>Summary</h2>
<p>{{ n.overall_summary }}</p>

{% if c.rubric %}
<table>
  <thead><tr><th>Area</th><th style="width:45%" aria-label="Score bar"></th><th class="num">Score</th></tr></thead>
  <tbody>{% for r in c.rubric %}<tr><td>{{ r.label }}</td><td><div class="bar {{ r.score | band }}"><i style="width: {{ r.score | pct }}%"></i></div></td><td class="num">{{ r.score | num(0) }}</td></tr>{% endfor %}</tbody>
</table>
{% endif %}

{% if n.technical_strengths %}
<h2>What you did well</h2>
{% for p in n.technical_strengths %}
<div class="card">
  <h3>{{ p.title }}</h3>
  <p>{{ p.detail }}</p>
  {% for eid in p.evidence_ids %}{% set e = evidence_by_id.get(eid) %}{% if e and e.quote %}<div class="evidence positive small"><q>{{ e.quote }}</q></div>{% endif %}{% endfor %}
</div>
{% endfor %}
{% endif %}

{% if n.areas_to_improve %}
<h2>Where to improve</h2>
{% for a in n.areas_to_improve %}
<div class="card">
  <h3>{{ a.title }}</h3>
  <p>{{ a.detail }}</p>
  <p><strong>How to improve:</strong> {{ a.learning_guidance }}</p>
</div>
{% endfor %}
{% endif %}

{% if n.strong_answers or n.incomplete_answers %}
<h2>Answer highlights</h2>
<div class="grid-2">
  <div>
  {% for h in n.strong_answers %}{% set q = questions_by_id.get(h.question_id) %}{% if q %}
    <div class="card"><span class="pill pos">Strong answer</span><p class="small"><strong>{{ q.text }}</strong></p><p class="small">{{ h.note }}</p></div>
  {% endif %}{% endfor %}
  </div>
  <div>
  {% for h in n.incomplete_answers %}{% set q = questions_by_id.get(h.question_id) %}{% if q %}
    <div class="card"><span class="pill warn">Could go further</span><p class="small"><strong>{{ q.text }}</strong></p><p class="small">{{ h.note }}</p></div>
  {% endif %}{% endfor %}
  </div>
</div>
{% endif %}

{% if c.coding or n.coding_feedback %}
<h2>Coding exercise</h2>
{% for cd in c.coding %}
<div class="card">
  <h3>{{ cd.title }} <span class="pill accent">{{ cd.language }}</span></h3>
  <p class="small muted">{% if cd.tests_total %}Tests passed: {{ cd.tests_passed }}/{{ cd.tests_total }} · {% endif %}Hints used: {{ cd.hints_used }} · Time: {{ cd.duration_seconds | duration }}</p>
  {% if cd.correctness_summary %}<p>{{ cd.correctness_summary }}</p>{% endif %}
</div>
{% endfor %}
{% if n.coding_feedback %}<p>{{ n.coding_feedback }}</p>{% endif %}
{% endif %}

{% if n.problem_solving_feedback or n.communication_feedback %}
<h2>Problem solving and communication</h2>
{% if n.problem_solving_feedback %}<p>{{ n.problem_solving_feedback }}</p>{% endif %}
{% if n.communication_feedback %}<p>{{ n.communication_feedback }}</p>{% endif %}
{% endif %}

{% if n.recommended_study_areas %}
<h2>Recommended study areas</h2>
{% for s in n.recommended_study_areas %}
<div class="card">
  <h3>{{ s.topic }}</h3>
  <p class="small">{{ s.why }}</p>
  {% if s.next_steps %}<ul class="clean">{% for step in s.next_steps %}<li>{{ step }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endfor %}
{% endif %}

{% if n.next_steps %}
<h2>Next steps</h2>
<ul class="clean">{% for step in n.next_steps %}<li>{{ step }}</li>{% endfor %}</ul>
{% endif %}

<div class="banner note"><p class="small">{{ c.note }}</p></div>
{% endblock %}
{% block footer_note %}Thank you for interviewing with us.{% endblock %}
