# Build context for the api/worker/migrate image: only pyproject.toml, uv.lock,
# alembic.ini, alembic/, app/ and models/ are needed.

# Local environments and secrets
.venv/
.env
.env.*

# Tests, caches and tooling output
tests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
**/__pycache__/
**/*.py[cod]

# Runtime data (local storage lives in the appdata volume)
data/
*.log

# Editors / VCS
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# Docker files themselves
Dockerfile
.dockerignore
docker/
