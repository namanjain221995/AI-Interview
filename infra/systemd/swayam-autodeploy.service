# Deploys dev (origin/hd-dev) and prod (origin/main) when their branch moves. Installed as a user unit by
# `make autodeploy-install`, which fills in the repository path; started by swayam-autodeploy.timer.
[Unit]
Description=Swayam: deploy dev/prod when hd-dev/main move on origin
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=@REPO@/scripts/autodeploy.sh
Environment=NO_COLOR=1
# A first prod build can take a while (images are built one at a time).
TimeoutStartSec=2h
Nice=5
